<idea-plugin>
  <id>dev.localebreeze.jetbrains</id>
  <name>LocaleBreeze</name>
  <vendor url="https://github.com/IvanKobtsev/LocaleBreeze">Ivan Kobtsev</vendor>
  <description><![CDATA[
    Context-aware i18n completion, navigation, references, unused-key hints, and persistent workspace health powered by the LocaleBreeze language server.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>JavaScript</depends>

  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.integrationProvider implementation="dev.localebreeze.jetbrains.LocaleBreezeLspIntegrationProvider"/>
    <gotoDeclarationHandler
        implementation="dev.localebreeze.jetbrains.LocaleBreezeGotoDeclarationHandler"
        order="first"/>
    <postStartupActivity implementation="dev.localebreeze.jetbrains.LocaleBreezeProjectActivity"/>
    <annotator language="JavaScript" implementationClass="dev.localebreeze.jetbrains.LocaleBreezeKeyAnnotator"/>
    <annotator language="JavaScript JSX" implementationClass="dev.localebreeze.jetbrains.LocaleBreezeKeyAnnotator"/>
    <annotator language="TypeScript" implementationClass="dev.localebreeze.jetbrains.LocaleBreezeKeyAnnotator"/>
    <annotator language="TypeScript JSX" implementationClass="dev.localebreeze.jetbrains.LocaleBreezeKeyAnnotator"/>
    <colorSettingsPage implementation="dev.localebreeze.jetbrains.LocaleBreezeColorSettingsPage"/>
    <projectConfigurable
        id="dev.localebreeze.jetbrains.settings"
        displayName="LocaleBreeze"
        instance="dev.localebreeze.jetbrains.LocaleBreezeConfigurable"/>
    <notificationGroup id="LocaleBreeze" displayType="BALLOON"/>
    <toolWindow
        id="LocaleBreeze"
        anchor="right"
        icon="/META-INF/pluginIcon.svg"
        factoryClass="dev.localebreeze.jetbrains.LocaleBreezeToolWindowFactory"/>
  </extensions>

  <actions>
    <action
        id="dev.localebreeze.jetbrains.CopyFullKey"
        class="dev.localebreeze.jetbrains.LocaleBreezeCopyFullKeyAction"
        text="Copy Full Translation Key"
        description="Copy the full LocaleBreeze translation key path">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
    <action
        id="dev.localebreeze.jetbrains.AddTranslationKey"
        class="dev.localebreeze.jetbrains.LocaleBreezeAddKeyAction"
        text="Add Translation Key…"
        description="Add the missing key to the default-locale translation file">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
