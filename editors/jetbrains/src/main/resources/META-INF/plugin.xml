<idea-plugin>
  <id>dev.localebreeze.jetbrains</id>
  <name>LocaleBreeze</name>
  <vendor url="https://github.com/IvanKobtsev/LocaleBreeze">Ivan Kobtsev</vendor>
  <description><![CDATA[
    Context-aware i18n completion, navigation, references, unused-key hints, and persistent workspace health powered by the LocaleBreeze language server.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.redhat.devtools.lsp4ij</depends>
  <depends optional="true" config-file="locale-breeze-commercial.xml">com.intellij.modules.lsp</depends>
  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="locale-breeze" name="LocaleBreeze" factoryClass="dev.localebreeze.jetbrains.LocaleBreezeLsp4ijServerFactory">
      <description><![CDATA[Context-aware navigation and completion for LocaleBreeze translation dictionaries.]]></description>
    </server>
    <fileNamePatternMapping patterns="*.js;*.jsx;*.ts;*.tsx;*.json" serverId="locale-breeze"/>
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="LocaleBreeze" displayType="BALLOON"/>
  </extensions>
</idea-plugin>
