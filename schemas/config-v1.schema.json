{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/IvanKobtsev/LocaleBreeze/main/schemas/config-v1.schema.json",
  "title": "LocaleBreeze configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["dictionaries", "defaultLocale", "scopedFunctions", "translationMethods", "fullKeyFunctions"],
  "properties": {
    "$schema": { "type": "string" },
    "dictionaries": { "type": "string", "description": "Pattern relative to the workspace root containing exactly one {locale} token. Absolute paths are not allowed; parent-directory (..) segments may reference dictionaries outside the workspace." },
    "defaultLocale": { "type": "string", "minLength": 1 },
    "keySeparator": { "type": "string", "minLength": 1, "default": "." },
    "scopedFunctions": { "$ref": "#/$defs/conventions" },
    "translationMethods": { "$ref": "#/$defs/conventions" },
    "fullKeyFunctions": { "$ref": "#/$defs/conventions" },
    "translationKeyTypes": { "$ref": "#/$defs/optionalConventions" },
    "translationKeyProps": { "$ref": "#/$defs/optionalConventions" },
    "ignoredScopes": {
      "type": "array",
      "default": [],
      "description": "Exact translation scopes and their descendants to exclude from frontend features.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "conventions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^\\s.]+(?:\\.[^\\s.]+)*$" }
    },
    "optionalConventions": {
      "type": "array", "uniqueItems": true, "default": [],
      "items": { "type": "string", "pattern": "^[^\\s.]+(?:\\.[^\\s.]+)*$" }
    }
  }
}
